{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "eleventy.config.js",
    "eslint.config.js",
    "scripts/**/*.js",
    "helper/**/*.js",
    "src/_11ty/**/*.js",
    "src/schemas/**/*.js",
    "src/js/**/*.js"
  ],
  "exclude": ["node_modules", "_site"]
}
