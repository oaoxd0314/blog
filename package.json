{
  "name": "11ty_blog",
  "version": "2.0.0",
  "description": "ChrisW's tech blog — Eleventy 3 + Tailwind CSS 4",
  "type": "module",
  "license": "ISC",
  "scripts": {
    "validate": "bun run scripts/validate.js",
    "prebuild": "bun run validate",
    "build:css": "bunx @tailwindcss/cli -i src/css/main.css -o _site/css/main.css --minify",
    "build:11ty": "bunx @11ty/eleventy",
    "build": "bun run build:css && bun run build:11ty",
    "watch:css": "bunx @tailwindcss/cli -i src/css/main.css -o _site/css/main.css --watch",
    "dev": "bun run validate && (bun run watch:css & bunx @11ty/eleventy --serve)",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "type-check": "bunx tsc --noEmit",
    "check": "bun run type-check && bun run lint && bun run format:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.0.0",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "luxon": "^3.5.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "zod": "^4.0.0"
  }
}
