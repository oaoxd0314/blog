<section class="flex flex-wrap gap-2">
  {% for tag in collections.tagList %}
    <a href="{{ ('/tags/' + (tag | slugify) + '/') | url }}"
       class="text-xs px-3 py-1 rounded-full bg-surface-2 text-fg-muted hover:text-fg hover:bg-accent-muted transition-colors">
      {{ tag }}
    </a>
  {% endfor %}
</section>
