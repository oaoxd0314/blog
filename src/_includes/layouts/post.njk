---
templateClass: tmpl-post
---
{% extends "layouts/base.njk" %}

{% block content %}
{% set shareUrl = metadata.url + page.url %}
<article class="prose">
  <header class="mb-8">
    <h1>{{ title }}</h1>
    <p class="flex flex-wrap items-center gap-2 text-sm text-fg-subtle">
      <time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
      <span aria-hidden="true">·</span>
      <span>{{ content | readingTime }} min read</span>
    </p>
    {%- if tags %}
      <p class="flex flex-wrap gap-2 mt-3">
        {%- for tag in tags %}
          {%- if tag not in ["posts", "post", "page", "static"] %}
            <a href="{{ ('/tags/' + (tag | slugify) + '/') | url }}"
               class="text-xs px-2 py-1 rounded-sm bg-surface-2 text-fg-muted hover:text-fg no-underline">{{ tag }}</a>
          {%- endif %}
        {%- endfor %}
      </p>
    {%- endif %}
  </header>

  {{ content | safe }}

  <hr />
  <p>
    <button
      type="button"
      data-share
      data-url="{{ shareUrl }}"
      data-title="{{ title }}"
      class="inline-flex items-center gap-2 text-sm px-3 py-2 rounded-md border border-border hover:border-accent transition-colors"
    >
      Share this post
    </button>
  </p>
</article>
{% endblock %}
