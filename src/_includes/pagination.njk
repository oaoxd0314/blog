{% if pagination.pages.length > 1 %}
<nav aria-label="Pagination" class="mt-10">
  <ul class="flex flex-wrap items-center justify-center gap-1 text-sm">
    {%- if pagination.href.previous -%}
      <li><a href="{{ pagination.href.previous | url }}"
             class="px-3 py-1.5 rounded-md border border-border hover:border-accent transition-colors">&lt;</a></li>
    {%- endif -%}

    {%- for pageEntry in pagination.pages -%}
      {%- set pageHref = pagination.hrefs[loop.index0] -%}
      <li>
        <a href="{{ pageHref }}"
           class="px-3 py-1.5 rounded-md border transition-colors
                  {% if page.url == pageHref %}border-accent bg-accent-muted text-fg{% else %}border-border hover:border-accent{% endif %}">
          {{ loop.index }}
        </a>
      </li>
    {%- endfor -%}

    {%- if pagination.href.next -%}
      <li><a href="{{ pagination.href.next | url }}"
             class="px-3 py-1.5 rounded-md border border-border hover:border-accent transition-colors">&gt;</a></li>
    {%- endif -%}
  </ul>
</nav>
{% endif %}
