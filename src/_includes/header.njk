<header class="border-b border-border-muted">
  <nav class="w-full mx-auto max-w-3xl px-4 h-16 flex items-center justify-between gap-4">
    <a href="{{ '/' | url }}" title="Homepage" class="font-bold text-lg tracking-snug">
      {{ metadata.title }}
    </a>

    <div class="flex items-center gap-5 text-sm text-fg-muted">
      {%- for entry in navigation %}
        <a href="{{ entry.url | url }}" class="hover:text-fg transition-colors">{{ entry.name }}</a>
      {%- endfor %}

      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle dark mode"
        class="grid place-items-center w-8 h-8 rounded-md border border-border hover:border-border-strong transition-colors"
      >
        <span data-theme-icon aria-hidden="true">🌙</span>
      </button>
    </div>
  </nav>
</header>
