---
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - nav
    - page
    - static
    - post
    - posts
    - tagList
  addAllPagesToCollections: true
layout: layouts/base.njk
eleventyComputed:
  title: Tagged “{{ tag }}”
permalink: /tags/{{ tag | slugify }}/
---

<section class="mb-8">
  <p class="text-xs font-semibold uppercase tracking-wide text-fg-subtle">Tag</p>
  <h1 class="text-3xl font-bold tracking-tight leading-tight mt-1">#{{ tag }}</h1>
</section>

{% set postslist = collections[ tag ] | reverse %}
{% include "postslist.njk" %}

<p class="mt-10 text-sm">
  <a href="{{ '/posts/' | url }}" class="text-accent hover:text-accent-hover">← All posts &amp; tags</a>
</p>
